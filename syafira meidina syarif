      "source": [
        "print(\"=== PROGRAM KONVERSI SUHU CELCIUS KE FAHRENHEIT ===\")\n",
        "\n",
        "# 1. Ambil input suhu Celcius menggunakan float() agar bisa menerima angka desimal\n",
        "celcius = float(input(\"Masukkan suhu dalam derajat Celcius: \"))\n",
        "\n",
        "# 2. Masukkan rumus: (celcius dikali 1.8) ditambah 32\n",
        "fahrenheit = (1.8) + 32\n",
        "\n",
        "# 3. Tampilkan hasilnya\n",
        "print(f\"Suhu {celcius}°C sama dengan {fahrenheit}°F\")"
